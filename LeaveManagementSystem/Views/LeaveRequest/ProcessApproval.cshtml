@model LeaveManagementSystem.Models.LeaveRequest

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Review Leave Application";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm p-4">
                <h2 class="fw-bold text-dark mb-1">Review Pipeline Case</h2>
                <p class="text-muted small mb-4">Evaluate staff assignment schedule window details below:</p>

                <!-- Case File Profile Context Box Layout Summary -->
                <div class="border rounded p-3 mb-4 bg-light">
                    <p class="mb-2"><strong>Staff Name:</strong> <span class="text-dark fw-semibold">@Model.Employee?.Name</span></p>
                    <p class="mb-2"><strong>Type Selected:</strong> <span class="text-dark fw-semibold">@Model.LeaveType?.LeaveName</span></p>
                    <p class="mb-2"><strong>Requested Frame:</strong> <span class="text-dark fw-semibold">@Model.FromDate.ToString("yyyy-MM-dd") to @Model.ToDate.ToString("yyyy-MM-dd")</span></p>
                    <p class="mb-0"><strong>Total Compute Window:</strong> <span class="badge bg-dark px-2 py-1">@Model.NumberOfDays Day(s)</span></p>
                </div>

                <!-- SUBMISSION PIPELINE FORM CORE ROUTING -->
                <form asp-action="SaveApprovalDecision" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="LeaveRequestId" value="@Model.LeaveRequestId" />

                    <!-- ======================================================================================== -->
                    <!-- UPDATED SECTION: STATUS SELECTION WITH DYNAMIC BINDING STATE CHECK RULES                 -->
                    <!-- ======================================================================================== -->
                    <label class="form-label fw-bold text-dark mb-2">Select Evaluation Status Action</label>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <!-- Pre-checks 'Approve' if the record status is already Approved or currently Pending -->
                            <input type="radio" class="btn-check" name="approvalAction" id="btnApprove" value="Approved"
                            @(Model.Status == "Approved" || Model.Status == "Pending" ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-success w-100 py-2 fw-bold" for="btnApprove">Approve Leave</label>
                        </div>
                        <div class="col-6">
                            <!-- Pre-checks 'Reject' only if the record status is explicitly set to Rejected -->
                            <input type="radio" class="btn-check" name="approvalAction" id="btnReject" value="Rejected"
                            @(Model.Status == "Rejected" ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-danger w-100 py-2 fw-bold" for="btnReject">Reject Leave</label>
                        </div>
                    </div>

                    <!-- ======================================================================================== -->
                    <!-- UPDATED SECTION: TEXTAREA PRE-POPULATED WITH HISTORICAL DATA REMARKS CONTEXT            -->
                    <!-- ======================================================================================== -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-bold text-dark">Manager Remarks / Notes Log</label>
                        <textarea name="Comments" class="form-control" rows="3" placeholder="Provide resolution summary logic here regarding decision reasons...">@Model.Comments</textarea>
                    </div>
                    <!-- ======================================================================================== -->
                    <!-- Execution submission layout controls line -->
                    <div class="d-flex align-items-center gap-2 border-top pt-3">
                        <button type="submit" class="btn btn-dark px-4 py-2 fw-bold">Process Action</button>
                        <a asp-action="Index" class="btn btn-secondary px-3 py-2">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
