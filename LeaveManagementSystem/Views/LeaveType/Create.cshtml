@model LeaveManagementSystem.Models.LeaveType

@{
    ViewData["Title"] = "Create Leave Type";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow-sm p-4">
            <h2 class="mb-4 text-dark fw-bold">Add New Leave Type</h2>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Validation summary box to catch any unseen backend bugs -->
                <div asp-validation-summary="All" class="text-danger mb-3 small fw-bold"></div>

                <!-- Corrected Mapping Key: LeaveName -->
                <div class="form-group mb-3">
                    <label asp-for="LeaveName" class="form-label fw-bold">Leave Type Name</label>
                    <input asp-for="LeaveName" name="LeaveName" class="form-control" placeholder="e.g., Casual Leave (CL)" required />
                    <span asp-validation-for="LeaveName" class="text-danger"></span>
                </div>

                <!-- Corrected Mapping Key: MaxDays -->
                <div class="form-group mb-4">
                    <label asp-for="MaxDays" class="form-label fw-bold">Maximum Days (Optional)</label>
                    <select asp-for="MaxDays" name="MaxDays" class="form-select form-control">
                        <option value="">Leave empty for unlimited days</option>
                        <option value="5">5 Days</option>
                        <option value="10">10 Days</option>
                        <option value="12">12 Days (Standard CL)</option>
                        <option value="18">18 Days (Standard PL)</option>
                        <option value="20">20 Days</option>
                        <option value="30">30 Days</option>
                        <option value="90">90 Days (Standard ML)</option>
                    </select>
                    <span asp-validation-for="MaxDays" class="text-danger"></span>
                </div>

                <div class="d-flex align-items-center mt-4">
                    <button type="submit" class="btn btn-success me-2 px-4">Save</button>
                    <a asp-action="Index" class="btn btn-secondary px-3">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
