@model IEnumerable<LeaveManagementSystem.Models.Department>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Departments";
}

<div class="container mt-4">
    <!-- Status Toast Alert Notifications Feedback -->
    @if (TempData["FileSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["FileSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FileError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["FileError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h2 class="mb-0 text-dark fw-bold">Departments</h2>

            <!-- Clean Action Control Pipeline Links -->
            <div class="d-flex gap-2">
                <a asp-action="ExportToExcel" class="btn btn-sm btn-outline-success">Export Excel</a>
                <a asp-action="ExportToPdf" class="btn btn-sm btn-outline-danger">Export PDF</a>
                <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm"><i class="bi bi-plus-lg"></i> Add New / Import</a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3" style="width: 70%;">Department Name</th>
                            <th class="text-center py-3" style="width: 30%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">@item.DepartmentName</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.DepartmentId" class="btn btn-outline-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.DepartmentId" class="btn btn-outline-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.DepartmentId" class="btn btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-4">
                                    No departments found. Click "Add New / Import" to register data rows.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
