@model LeaveManagementSystem.Models.Department

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Department Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3 card shadow-sm p-4">
            <h2 class="mb-4 fw-bold text-dark">Department Details</h2>

            <div class="mb-4 pb-3 border-bottom">
                <label class="text-muted d-block small uppercase fw-bold mb-1">Department Identification Number (ID)</label>
                <p class="fs-5 text-dark fw-semibold">@Model.DepartmentId</p>
            </div>

            <div class="mb-4">
                <label class="text-muted d-block small uppercase fw-bold mb-1">Department Name</label>
                <p class="fs-4 text-dark fw-bold">@Model.DepartmentName</p>
            </div>

            <div class="d-flex align-items-center mt-4 pt-2">
                <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-warning px-4 me-2">Edit Details</a>
                <a asp-action="Index" class="btn btn-secondary px-3">Back to List</a>
            </div>
        </div>
    </div>
</div>

