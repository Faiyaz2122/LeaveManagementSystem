@model LeaveManagementSystem.Models.Department

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Department";
}

<div class="container mt-4">
    <div class="row g-4 justify-content-center">

        <!-- Segment 1: Manual Input Creation Form -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4 h-100">
                <h3 class="mb-4 text-dark fw-bold">Create Single Department</h3>

                <form asp-action="Create">
                    <div class="form-group mb-4">
                        <label asp-for="DepartmentName" class="form-label fw-bold">Department Name</label>
                        <input asp-for="DepartmentName" class="form-control" placeholder="Enter department name..." />
                        <span asp-validation-for="DepartmentName" class="text-danger"></span>
                    </div>

                    <div class="d-flex align-items-center">
                        <button type="submit" class="btn btn-success me-2 px-4">Save</button>
                        <a asp-action="Index" class="btn btn-secondary px-3">Back to List</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Segment 2: Batch Upload Excel Data Form -->
        <div class="col-md-5">
            <div class="card shadow-sm p-4 h-100 bg-light border-dashed">
                <h3 class="mb-3 text-dark fw-bold">Bulk Upload Spreadsheet</h3>
                <p class="text-muted small mb-4">Select a populated Excel file (.xlsx) containing a column header named <strong>DepartmentName</strong> to register records simultaneously.</p>

                <form asp-action="ImportFromExcel" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary">Choose Spreadsheet File</label>
                        <input type="file" name="excelFile" class="form-control bg-white" accept=".xlsx" required />
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-2">
                        <i class="bi bi-upload me-1"></i> Upload & Import Batch
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
