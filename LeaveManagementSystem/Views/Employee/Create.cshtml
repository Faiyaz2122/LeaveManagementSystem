@model LeaveManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3 card shadow-sm p-4">
            <h2 class="mb-4 fw-bold text-dark">Create Employee</h2>

            <form asp-action="Create">
                <!-- ======================================================= -->
                <!-- VALIDATION SUMMARY BOX: Captures hidden backend errors  -->
                <!-- ======================================================= -->
                <div asp-validation-summary="All" class="text-danger mb-3 fw-bold small"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-check mb-3 mt-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                    <label class="form-check-label fw-bold" for="isActiveCheck">
                        Is Active Employee
                    </label>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="DepartmentId" class="form-label fw-bold">Department Assignment</label>
                    <select asp-for="DepartmentId" name="DepartmentId" class="form-select form-control" asp-items="ViewBag.DepartmentId">
                        <option value="">-- Choose Assigned Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <!-- Add this form-group section into your Create.cshtml view form -->
                <div class="form-group mb-4">
                    <label class="form-label fw-bold text-dark">System Clearance Role (Optional)</label>
                    <select name="Role" class="form-select form-control">
                        <option value="">-- No System Role Access Assigned (NULL) --</option>
                        <option value="Employee">Employee Access Mode</option>
                        <option value="Manager">Manager Access Mode</option>
                    </select>
                </div>


                <div class="d-flex align-items-center mt-4">
                    <button type="submit" class="btn btn-success me-2 px-4">Save</button>
                    <a asp-action="Index" class="btn btn-secondary px-3">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}