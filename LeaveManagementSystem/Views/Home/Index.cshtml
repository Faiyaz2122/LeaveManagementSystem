@{
    ViewData["Title"] = "Executive Hub Dashboard";
}

<div class="container mt-2">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border border-light">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-dark mb-2">Welcome to your HR Control Hub</h1>
            <p class="col-md-9 fs-5 text-secondary">Manage department records, structure organizational staff profiles, configure custom allocation rules, and handle employee leave requests from a single central portal.</p>
            <hr class="my-4 text-muted" style="opacity: 0.15;" />
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="LeaveRequest" asp-action="Create" class="btn btn-primary btn-lg px-4 shadow-sm fw-semibold"><i class="bi bi-calendar-plus me-2"></i>Apply For Leave</a>

                <!-- Role-secured contextual action button -->
                @if (Context.Session.GetString("UserRole") == "Manager")
                {
                    <a asp-controller="LeaveRequest" asp-action="Index" class="btn btn-outline-dark btn-lg px-4 fw-semibold"><i class="bi bi-speedometer2 me-2"></i>Open Leave Matrix</a>
                }
                else
                {
                    <a asp-controller="LeaveRequest" asp-action="HistoryLog" class="btn btn-outline-dark btn-lg px-4 fw-semibold"><i class="bi bi-journal-text me-2"></i>View My Leave Logs</a>
                }
            </div>
        </div>
    </div>

    <!-- ROLE PRIVILEGE SHIELD: SECURING SYSTEM CONFIGURATION MODULES            -->
    @if (Context.Session.GetString("UserRole") == "Manager")
    {
        <h3 class="fw-bold text-dark mb-4 mt-5"><i class="bi bi-grid-1x2-fill me-2 text-secondary"></i>System Configuration Modules</h3>
        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-xl-4">

            <!-- Card 1: Departments -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-primary border-4 p-2">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title fw-bold text-dark mb-0">Departments</h5>
                                <i class="bi bi-building fs-3 text-primary bg-light p-2 rounded"></i>
                            </div>
                            <p class="card-text text-muted small">Manage operational business teams, view active indexes, or run bulk Excel batch data integrations.</p>
                        </div>
                        <a asp-controller="Department" asp-action="Index" class="btn btn-sm btn-outline-primary w-100 fw-bold mt-3">Open Module</a>
                    </div>
                </div>
            </div>

            <!-- Card 2: Employees -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-success border-4 p-2">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title fw-bold text-dark mb-0">Employees</h5>
                                <i class="bi bi-people fs-3 text-success bg-light p-2 rounded"></i>
                            </div>
                            <p class="card-text text-muted small">Maintain staff profiles, manage team allocations via selection dropdowns, and track profile status flags.</p>
                        </div>
                        <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-success w-100 fw-bold mt-3">Open Module</a>
                    </div>
                </div>
            </div>

            <!-- Card 3: Leave Types -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-info border-4 p-2">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title fw-bold text-info mb-0">Leave Types</h5>
                                <i class="bi bi-sliders fs-3 text-info bg-light p-2 rounded"></i>
                            </div>
                            <p class="card-text text-muted small">Configure limits for category options (PL, CL, ML) using dynamic max days selector rules.</p>
                        </div>
                        <a asp-controller="LeaveType" asp-action="Index" class="btn btn-sm btn-outline-info w-100 fw-bold mt-3">Open Module</a>
                    </div>
                </div>
            </div>

            <!-- Card 4: Historical Logs -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-purple border-4 p-2" style="border-top-color: #6610f2 !important;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title fw-bold text-dark mb-0">Leave Logs</h5>
                                <i class="bi bi-journal-text fs-3 bg-light p-2 rounded" style="color: #6610f2;"></i>
                            </div>
                            <p class="card-text text-muted small">View full leave records, filter histories by employee, and check manager remarks context.</p>
                        </div>
                        <a asp-controller="LeaveRequest" asp-action="HistoryLog" class="btn btn-sm text-white w-100 fw-bold mt-3" style="background-color: #6610f2;">Open Module</a>
                    </div>
                </div>
            </div>

        </div>
    }
</div>
